# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/shaina-studyvault

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cloudinary (file storage for note documents + thumbnails)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer — used for password reset + admin replies)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="SHAINA StudyVault <no-reply@shainastudyvault.com>"

# Admin seed (used only by `npm run seed:admin`, never by public registration)
ADMIN_NAME=SHAINA Admin
ADMIN_USERNAME=shaina_admin
ADMIN_EMAIL=admin@shainastudyvault.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
